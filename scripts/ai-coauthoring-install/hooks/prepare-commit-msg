#!/usr/bin/env bash
# Installed by AI Coauthoring (scripts/ai-coauthoring-install/install-hooks.sh).
# Appends an AI-attribution trailer to the commit message using character stats the VS Code
# extension has been tracking locally. Never blocks the commit -- any failure here is swallowed.

NODE_BIN="$(command -v node || true)"
if [ -z "$NODE_BIN" ]; then
  exit 0
fi

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$NODE_BIN" "$HOOK_DIR/attribution-hook.js" prepare-commit-msg "$1" "${2:-}" "${3:-}" || true
exit 0
